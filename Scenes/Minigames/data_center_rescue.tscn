[node name="Description" type="Label" parent="TutorialOverlay/TutorialCenter/TutorialPanel/TutorialMargin/TutorialContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.81, 0.84, 1)
theme_override_font_sizes/font_size = 14
text = "1. Explore usando WASD ou as setas.\n2. Aproxime-se de cada servidor e identifique a cor do incidente.\n3. Use Q para MALWARE, B para BRUTE FORCE e P para FALHA DE ENERGIA.\n4. Encontre o CARTÃO amarelo para acessar os racks com cadeado.\n5. Resolva os seis incidentes e retorne ao terminal verde."
autowrap_mode = 2

[node name="Warning" type="Label" parent="TutorialOverlay/TutorialCenter/TutorialPanel/TutorialMargin/TutorialContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.55, 0.46, 1)
theme_override_font_sizes/font_size = 13
text = "Cada servidor possui seu próprio prazo. Resposta errada custa 7 segundos; bots retiram integridade e devolvem você ao início."
