theme_override_font_sizes/font_size = 15
text = "COMO JOGAR\n\n1. [WASD / SETAS] Vá até um roteador numerado.\n2. [E] Escaneie e leia as pistas no painel direito.\n3. Escaneie pelo menos 2 redes e compare nome, proteção e identidade.\n4. [C] Conecte-se perto da rede que você acredita ser verdadeira.\n5. Depois de acertar, corra até o TERMINAL VERDE."
autowrap_mode = 2

[node name="Warning" type="Label" parent="TutorialOverlay/TutorialCenter/TutorialPanel/TutorialMargin/TutorialContent"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.55, 0.56, 1)
theme_override_font_sizes/font_size = 13
text = "ATENÇÃO: rede falsa rouba 30% dos dados. Sniffer vermelho rouba 20%. A VPN roxa bloqueia uma interceptação."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Concept" type="Label" parent="TutorialOverlay/TutorialCenter/TutorialPanel/TutorialMargin/TutorialContent"]
